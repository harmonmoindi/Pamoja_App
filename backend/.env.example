# Copy this file to backend/.env and fill in your own values.
# NEVER commit backend/.env: it holds passwords and keys.

# Flask
FLASK_APP=run.py
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-too-use-another-long-random-string
JWT_EXPIRES_HOURS=8

# PostgreSQL: use YOUR OWN local user, password and database
DATABASE_URL=postgresql://pamoja_user:your_password@localhost:5432/pamoja_db

# Front-end address allowed to call the API (comma separated if several)
CORS_ORIGINS=http://localhost:5173

# Password given to every seeded demo account
SEED_PASSWORD=Pamoja#2026

# M-Pesa Daraja (sandbox): Donor dev fills these in
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ReliefWeb: Agency dev
RELIEFWEB_APPNAME=
